---
import BaseLayout from '@/layouts/BaseLayout.astro';

import Notes from '@/components/Notes.astro';
import NoteHeader from '@/components/NoteHeader.astro';
import { getNotes } from '@/lib/notes';

const notes = await getNotes();
---

<BaseLayout headProps={{ title: 'Writings', image: '/og/notes.png' }}>
  <NoteHeader title='Writings' />
  {notes.length ? <Notes /> : <p>In progress...</p>}
</BaseLayout>
