---
import { LINKS } from '@/consts';
---

<footer>
  <span>
    [↗]: {LINKS.map(({ label, href }) => (
      <><a target='_blank' rel='me' href={href}>{label}</a>, </>
    ))}<a target='_blank' href='/rss.xml'>RSS</a>
  </span>
  <div class='bottom'>
    <p>© 2026 YC |</p>
    <button type='button' id='theme-toggle' aria-label='Switch between light and dark mode' title='Switch theme'>
      <svg width='16' height='16' viewBox='0 0 16 16' aria-hidden='true'>
        <circle cx='8' cy='8' r='6.5' fill='none' stroke='currentColor' stroke-width='1.5' />
        <path d='M8 1.5a6.5 6.5 0 0 1 0 13z' fill='currentColor' />
      </svg>
    </button>
  </div>
</footer>

<script>
  const button = document.getElementById('theme-toggle');
  const dark = matchMedia('(prefers-color-scheme: dark)');

  const current = () => {
    try {
      return localStorage.getItem('theme') || (dark.matches ? 'dark' : 'light');
    } catch {
      return dark.matches ? 'dark' : 'light';
    }
  };

  button?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    document.documentElement.style.colorScheme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  footer {
    position: relative;

    padding-top: 1em;
    margin-top: 3em;
  }

  span {
    color: var(--theme-sub-text);
  }

  .bottom {
    display: flex;
    align-items: center;
    gap: 1.5ch;
    margin-top: 0.5em;
  }

  button {
    display: inline-flex;
    padding: 0;
    border: 0;
    background: none;
    color: var(--theme-sub-text);
    cursor: pointer;
  }

  button:hover {
    color: var(--theme-text);
  }

  p {
    color: var(--theme-sub-text);
  }

  footer::before {
    content: '';
    position: absolute;

    top: 0;
    width: 100%;

    border-top: 1px solid var(--theme-sub-text);
  }
</style>
